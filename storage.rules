rules_version = '2';

// uploads/{uid}/{jobId}/{fileName}: 本人のみアップロード・閲覧可能。500MBまで、動画のみ。
// results/{uid}/{jobId}/{fileName}: Cloud Functions（Admin SDK）だけが書き込み、本人のみ閲覧可能。
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{uid}/{jobId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 500 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    match /results/{uid}/{jobId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
